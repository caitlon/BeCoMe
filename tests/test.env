# The environment every test run and every test stack starts from.
#
# One list for all of them: tests/conftest.py reads it before anything imports api,
# scripts/ci/test-env.sh exports it for the scripts that start the tests or the API,
# and the CI jobs append it to $GITHUB_ENV. A variable in the process beats .env, so
# a developer's .env, which can name a live mail provider, a tracing key or a model
# host, never reaches a test. A blank value overrides .env; a missing one would not.
#
# Plain KEY=VALUE lines, no quotes, no expansion.
APP_ENV=test
TESTING=1
EMAIL_PROVIDER=console
EMAIL_API_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
REDIS_URL=
ASSISTANT_LANGSMITH_ENABLED=false
ASSISTANT_LANGSMITH_API_KEY=
ASSISTANT_API_KEY_OVH=
ASSISTANT_ANSWER_PROVIDER=local
ASSISTANT_LLM_PROVIDER=local
ASSISTANT_EMBEDDING_PROVIDER=local
ASSISTANT_ANSWER_LLM_BASE_URL=http://127.0.0.1:8084/v1
ASSISTANT_LLM_BASE_URL=http://127.0.0.1:8081/v1
ASSISTANT_EMBEDDING_BASE_URL=http://127.0.0.1:8082/v1
ASSISTANT_RERANK_BASE_URL=http://127.0.0.1:8083/v1
LANGSMITH_TRACING=
LANGSMITH_TRACING_V2=
LANGCHAIN_TRACING=
LANGCHAIN_TRACING_V2=
LANGSMITH_RUNS_ENDPOINTS=
LANGCHAIN_RUNS_ENDPOINTS=
