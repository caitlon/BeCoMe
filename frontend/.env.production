# Vite mode: production (npm run build). The relative path is only a fallback: nginx
# serves static files and does not proxy /api, so a built image needs the API URL.
# ARG VITE_API_URL in frontend/Dockerfile overrides it: the deploys pass the API's
# own host, and docker/docker-compose.yml passes http://localhost:8000/api/v1.
VITE_API_URL=/api/v1
