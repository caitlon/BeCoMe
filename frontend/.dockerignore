# Keep the Docker build context small so `COPY . .` (after `npm ci`) doesn't pull
# in local artifacts and bust the dependency layer cache. Mode env files
# (.env.production, .env.development, .env.test) are intentionally kept, since the
# Vite build reads them; only local overrides are excluded.

# Dependencies and build output, reinstalled or regenerated inside the image.
node_modules
dist

# Test output and reports
coverage
test-results
playwright-report
.playwright-mcp

# Local-only env overrides
.env.local
.env.*.local

# Editor / OS cruft
.vscode
.DS_Store

# Server-render bundle, built to prerender the public pages and never shipped
dist-ssr

# The throwaway TLS key and certificate of the local E2E setup
.certs
