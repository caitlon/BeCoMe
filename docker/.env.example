# Copy to .env | Generate secret: openssl rand -hex 32
# APP_ENV selects the profile: dev | prod (default: dev; test is the pytest runner's profile)
APP_ENV=dev
SECRET_KEY=

# Optional - defaults shown
# POSTGRES_USER=become
# POSTGRES_PASSWORD=become
# POSTGRES_DB=become
# ASSISTANT_ENABLED=false  # build arg only: true installs the assistant extra into the API image; Compose does not pass it to the container
