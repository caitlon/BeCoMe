# Profile overrides for production (prod).
# Export APP_ENV=prod in the deployment platform (Railway) to select this profile.
# On Railway set these as service variables; copy to ../.env.prod at the repository
# root (gitignored) only for local production-like runs.
# Production rejects an empty or default SECRET_KEY and any sqlite DATABASE_URL.

# Generate: openssl rand -hex 32
SECRET_KEY=
DATABASE_URL=postgresql://user:password@host:5432/become
# Required here: privileged URL used only by Alembic migrations (DDL), so DATABASE_URL
# above can run as a least-privilege role. Startup fails when it is unset here, so
# the split is never silently lost; set it explicitly even if it matches DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://migrator:password@host:5432/become
DEBUG=false
# Matches the prod profile's own default. Keep it at INFO: the DEBUG traces exist for
# a developer reading a local console, and shipping them from production costs drain
# volume without answering a question production asks.
LOG_LEVEL=INFO
CORS_ORIGINS=["https://your-domain.example"]
API_PUBLIC_URL=https://api.becomify.app

# Shared Redis for the rate limiter and token revocation/session store (required in prod).
REDIS_URL=

# Cloudflare origin lock (required on every deployed service, since the app refuses to
# boot without it). Use a DIFFERENT value per environment.
# A secret you generate (openssl rand -hex 32) and set in TWO matching places: here on
# Railway, and as the X-Origin-Verify request header Cloudflare injects via a Transform
# Rule. It lets the origin trust CF-Connecting-IP instead of a spoofable X-Forwarded-For;
# a request without it is treated as a direct (unverified) origin hit.
CLOUDFLARE_ORIGIN_SECRET=

# Railway injects bucket credentials when a bucket is attached to the service:
# BUCKET_NAME / BUCKET_ENDPOINT / BUCKET_ACCESS_KEY_ID / BUCKET_SECRET_ACCESS_KEY

# Email: send real transactional mail via Resend (password reset, account
# verification). EMAIL_FROM must be on a domain verified in Resend;
# FRONTEND_BASE_URL is the deployed frontend origin. EMAIL_API_KEY is required
# here: startup fails without it, since the fallback console sender would print
# links to stdout instead of delivering them.
EMAIL_PROVIDER=http
EMAIL_API_KEY=re-set-the-real-resend-key-in-railway
EMAIL_FROM=no-reply@your-domain.example
EMAIL_FROM_NAME=BeCoMe
FRONTEND_BASE_URL=https://your-frontend.example

# Cloudflare Turnstile bot check on register / login / forgot-password /
# resend-verification. Every deployed service is meant to run the check; leaving it off
# starts the service but records an ERROR on startup, and turning it on without the two
# values below refuses the boot, since every request would be refused anyway.
# TURNSTILE_SECRET_KEY is the widget's secret from the Turnstile dashboard,
# paired with the VITE_TURNSTILE_SITE_KEY the frontend service renders.
# TURNSTILE_HOSTNAMES lists the frontend hosts a token may be minted on; a token naming
# anything else is refused, so keep localhost out of it here.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=set-the-real-turnstile-secret-in-railway
TURNSTILE_HOSTNAMES=["your-frontend.example"]

# AI assistant on the deployed prod service (set in Railway, not here). It is off until the
# corpus database, the variables below and the frontend build flag VITE_ASSISTANT_ENABLED are
# in place; then ASSISTANT_ENABLED=true is set on the service. The same variable is a build
# arg of docker/Dockerfile, where it installs the assistant extra. Every model role must be
# hosted there.
ASSISTANT_ENABLED=false
# Sources stay hidden from the user on prod; the assistant_turn log record still lists them.
ASSISTANT_SHOW_SOURCES=false
# ASSISTANT_ANSWER_PROVIDER=api
# ASSISTANT_LLM_PROVIDER=api
# ASSISTANT_EMBEDDING_PROVIDER=api
# ASSISTANT_ANSWER_LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# ASSISTANT_LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# ASSISTANT_EMBEDDING_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# The code defaults for the three model ids are the local llama-server ids, which the
# provider does not serve, and Settings does not check them. Set all three in api mode.
# ASSISTANT_ANSWER_LLM_MODEL=Qwen3.5-9B
# ASSISTANT_LLM_MODEL=Qwen3.5-9B
# ASSISTANT_EMBEDDING_MODEL=bge-m3
# ASSISTANT_API_KEY_OVH=
# ASSISTANT_API_REASONING_EFFORT=none
# The read-only role on the separate corpus database. Settings refuses anything but a
# postgresql+psycopg:// URL with one host and a database in the URL itself, a single
# sslmode=require, and the application database; see api/assistant/README.md.
# ASSISTANT_VECTOR_DB_URL=
# LangSmith traces of the assistant (a turn is one trace). Tracing is switched on only by
# ASSISTANT_LANGSMITH_ENABLED; on a deployed service Settings requires the EU endpoint, a
# key and a project, and refuses LANGSMITH_TRACING and its LANGCHAIN_ variants.
# ASSISTANT_LANGSMITH_ENABLED=true
# ASSISTANT_LANGSMITH_API_KEY=
# ASSISTANT_LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# ASSISTANT_LANGSMITH_PROJECT=become-assistant-prod
