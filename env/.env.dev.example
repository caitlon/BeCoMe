# Profile overrides for local development (dev).
# Select the profile by exporting APP_ENV in your shell (dev is the default):
#   APP_ENV=dev uv run uvicorn api.main:app --reload
# Copy to ../.env.dev at the repository root (gitignored). Loaded after the base
# .env, so values here win.

SECRET_KEY=changeme
DATABASE_URL=postgresql://become:become@localhost:5432/become
# The local PostgreSQL from docker/docker-compose.yml, bound to 127.0.0.1 only:
#   docker compose -f docker/docker-compose.yml up -d db
# Alembic targets PostgreSQL, so this is also the only local setup where a migration
# is exercised the way production runs it. Falling back to sqlite:///./become.db works
# and uses create_all instead, which skips migrations entirely. To migrate a remote
# database ad hoc, set ALEMBIC_DATABASE_URL when running alembic.
DEBUG=true
# Matches the dev profile's own default; spelled out so the level is obvious here.
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
API_PUBLIC_URL=http://localhost:8000

# Photo storage is optional locally; attach a Railway bucket to enable uploads.
# BUCKET_NAME / BUCKET_ENDPOINT / BUCKET_ACCESS_KEY_ID / BUCKET_SECRET_ACCESS_KEY

# Cloudflare origin lock (required on every deployed service, since the app refuses to
# boot without it). A secret you generate (openssl rand -hex 32) and set in TWO matching
# places: here on Railway, and as the X-Origin-Verify request header Cloudflare injects
# via a Transform Rule scoped to this environment's API host. It lets the origin read the
# client from CF-Connecting-IP; a request without it is treated as a direct (unverified)
# origin hit and keyed under a single constant. Use a different value per environment, so
# a leak from one does not unlock the others.
CLOUDFLARE_ORIGIN_SECRET=

# Cloudflare Turnstile bot check on register / login / forgot-password /
# resend-verification. Every deployed service is meant to run the check; leaving it off
# starts the service but records an ERROR on startup, and turning it on without the two
# values below refuses the boot, since every request would be refused anyway.
# TURNSTILE_SECRET_KEY is the widget's secret from the Turnstile dashboard,
# paired with the VITE_TURNSTILE_SITE_KEY the frontend service renders.
# TURNSTILE_HOSTNAMES lists the frontend hosts a token may be minted on; a token naming
# anything else is refused. This applies to the deployed dev service, not to a laptop.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=["dev.your-domain.example"]
